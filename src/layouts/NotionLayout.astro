---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Cristian Crețu',
  description = 'Design Engineer.',
  image = 'https://cretu.dev/static/images/og.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <ViewTransitions />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/static/favicons/favicon-196x196.png" />
    <link rel="apple-touch-icon" href="/static/favicons/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/static/favicons/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title === 'Cristian Crețu' ? title : `${title} | Cristian Crețu`}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#fafafa" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Cristian Crețu" />
    <meta property="og:locale" content="en-US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <meta property="twitter:site" content="@cristicrtu" />

    <!-- Author -->
    <meta name="author" content="Cristian Crețu" />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Google Verification -->
    <meta name="google-site-verification" content="fK4YqLAHjoaynXLF1e5gaPzDNOircgiYSgAwSXqr61o" />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --notion-bg: #fafafa;
        --notion-ink: #18181b;
        --notion-muted: #52525b;
        --notion-faint: #9b9ba1;
        --notion-rule: rgba(24, 24, 27, 0.08);
        --notion-tint: rgba(24, 24, 27, 0.05);
        --notion-tint-strong: rgba(24, 24, 27, 0.06);
        --notion-code-bg: #f5f5f7;
        --notion-selection: rgba(24, 24, 27, 0.12);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        background: var(--notion-bg);
        color: var(--notion-ink);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-feature-settings: 'cv11', 'ss01';
        font-variant-ligatures: contextual;
        min-height: 100vh;
      }

      ::selection {
        background: var(--notion-selection);
        color: var(--notion-ink);
      }

      .page-nav {
        position: fixed;
        top: 22px;
        left: 22px;
        right: 22px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.5;
        z-index: 50;
        pointer-events: none;
      }

      .page-nav .name {
        color: var(--notion-ink);
        font-weight: 500;
        pointer-events: auto;
      }

      .page-nav .name .yr {
        color: var(--notion-faint);
        font-weight: 400;
      }

      .page-nav .links {
        display: flex;
        flex-direction: column;
        text-align: right;
        color: var(--notion-faint);
        gap: 2px;
      }

      .page-nav .links a {
        pointer-events: auto;
        color: var(--notion-faint);
        text-decoration: none;
        transition: color 160ms ease;
      }

      .page-nav .links a:hover {
        color: var(--notion-ink);
      }

      .page-body {
        max-width: 720px;
        margin: 0;
        padding: 132px 32px 200px 96px;
      }

      /* External link ↗ arrow — mirrors globals.css since NotionLayout is standalone */
      a[href^="http"]:not([href*="cretu.dev"])::after {
        content: '↗';
        display: inline-block;
        font-size: 0.78em;
        margin-left: 2px;
        vertical-align: 0.05em;
        opacity: 0.45;
        font-feature-settings: normal;
        transition: opacity 160ms ease, transform 160ms ease;
      }
      a[href^="http"]:not([href*="cretu.dev"]):hover::after {
        opacity: 0.85;
        transform: translate(0.5px, -0.5px);
      }
      a[data-mention]::after,
      a[data-no-arrow]::after,
      .page-nav .links a::after {
        content: none !important;
      }

      @media (max-width: 720px) {
        .page-nav {
          top: 18px;
          left: 18px;
          right: 18px;
          font-size: 12px;
        }
        .page-body {
          padding: 108px 24px 160px 60px;
        }
      }
    </style>
  </head>
  <body>
    <header class="page-nav">
      <a class="name" href="/">Cristian Crețu<br /><span class="yr">2026</span></a>
      <nav class="links">
        <a href="/work">Work</a>
        <a href="/writing">Writing</a>
        <a href="https://x.com/cristicrtu" target="_blank" rel="noopener noreferrer" data-no-arrow>X</a>
        <a href="mailto:hi@cretu.dev" data-no-arrow>Email</a>
      </nav>
    </header>
    <main class="page-body" transition:animate="fade">
      <slot />
    </main>
  </body>
</html>
