---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Cristian Crețu',
  description = 'Design Engineer.',
  image = 'https://cretu.dev/static/images/og.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <ViewTransitions />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/static/favicons/favicon-196x196.png" />
    <link rel="apple-touch-icon" href="/static/favicons/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/static/favicons/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title === 'Cristian Crețu' ? title : `${title} | Cristian Crețu`}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f10" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Cristian Crețu" />
    <meta property="og:locale" content="en-US" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <meta property="twitter:site" content="@cristicrtu" />

    <meta name="author" content="Cristian Crețu" />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      /* Apply theme before paint to avoid flash. Re-apply on view transitions. */
      (function applyTheme() {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = saved === 'dark' || (!saved && prefersDark);
          document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        } catch (_) {
          /* SSR / blocked storage fallback */
          document.documentElement.dataset.theme = 'light';
        }
      })();
      document.addEventListener('astro:after-swap', () => {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = saved === 'dark' || (!saved && prefersDark);
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
      });
    </script>

    <style is:global>
      :root,
      html[data-theme='light'] {
        --notion-bg: #fafafa;
        --notion-surface: #ffffff;
        --notion-ink: #18181b;
        --notion-muted: #4a4a52;
        --notion-faint: #7a7a80;
        --notion-dim: #c8c8cd;
        --notion-rule: rgba(24, 24, 27, 0.08);
        --notion-tint: rgba(24, 24, 27, 0.05);
        --notion-tint-strong: rgba(24, 24, 27, 0.06);
        --notion-tint-hover: rgba(24, 24, 27, 0.09);
        --notion-row-hover: rgba(24, 24, 27, 0.03);
        --notion-row-focus: rgba(24, 24, 27, 0.06);
        --notion-code-bg: #f5f5f7;
        --notion-selection: rgba(24, 24, 27, 0.12);
        --notion-shadow: 0 1px 2px rgba(24, 24, 27, 0.06), 0 4px 12px rgba(24, 24, 27, 0.06);
      }

      html[data-theme='dark'] {
        --notion-bg: #0f0f10;
        --notion-surface: #18181b;
        --notion-ink: #ececef;
        --notion-muted: #b0b0b8;
        --notion-faint: #8a8a92;
        --notion-dim: #3f3f46;
        --notion-rule: rgba(255, 255, 255, 0.08);
        --notion-tint: rgba(255, 255, 255, 0.05);
        --notion-tint-strong: rgba(255, 255, 255, 0.14);
        --notion-tint-hover: rgba(255, 255, 255, 0.10);
        --notion-row-hover: rgba(255, 255, 255, 0.04);
        --notion-row-focus: rgba(255, 255, 255, 0.07);
        --notion-code-bg: #1c1c1f;
        --notion-selection: rgba(255, 255, 255, 0.14);
        --notion-shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 4px 12px rgba(0, 0, 0, 0.4);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        background: var(--notion-bg);
        transition: background 220ms ease, color 220ms ease;
      }
      body {
        background: var(--notion-bg);
        color: var(--notion-ink);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-feature-settings: 'cv11', 'ss01';
        font-variant-ligatures: contextual;
        min-height: 100vh;
        transition: background 220ms ease, color 220ms ease;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      ::selection {
        background: var(--notion-selection);
        color: var(--notion-ink);
      }

      /* --- Corner nav --- */
      .page-nav {
        position: fixed;
        top: 22px;
        left: 22px;
        right: 22px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.5;
        z-index: 50;
        pointer-events: none;
      }
      .page-nav .name {
        color: var(--notion-ink);
        font-weight: 500;
        pointer-events: auto;
        transition: color 160ms ease;
      }
      .page-nav .name .yr {
        color: var(--notion-faint);
        font-weight: 400;
      }
      .page-nav .links {
        display: flex;
        flex-direction: column;
        text-align: right;
        color: var(--notion-faint);
        gap: 2px;
        align-items: flex-end;
      }
      .page-nav .links a,
      .page-nav .links button {
        pointer-events: auto;
        color: var(--notion-faint);
        background: none;
        border: 0;
        padding: 0;
        font: inherit;
        cursor: pointer;
        transition: color 160ms ease;
      }
      .page-nav .links a:hover,
      .page-nav .links button:hover {
        color: var(--notion-ink);
      }
      .theme-toggle {
        margin-top: 6px;
        padding: 4px;
        margin-right: -4px;
        margin-left: -4px;
        margin-bottom: -4px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--notion-faint);
        opacity: 0.85;
        transition: color 160ms ease, opacity 160ms ease;
      }
      .page-nav .links button.theme-toggle:hover {
        color: var(--notion-ink);
        opacity: 1;
      }
      .theme-toggle svg {
        width: 15px;
        height: 15px;
        display: block;
        transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 200ms ease;
      }
      .theme-toggle.rotating svg {
        transform: rotate(180deg);
      }
      html[data-theme='dark'] .theme-toggle .sun { display: none; }
      html[data-theme='light'] .theme-toggle .moon { display: none; }

      /* Meta link — for "all essays", "all work", "view more" rows
         Renders as italic muted with subtle chevron, never as a Mention pill */
      .meta-link {
        font-style: italic;
        color: var(--notion-faint);
        text-decoration: none;
        transition: color 160ms ease;
      }
      .meta-link:hover { color: var(--notion-ink); }
      .meta-link::after {
        content: '';
        display: inline-block;
        width: 0.6em;
        height: 0.6em;
        margin-left: 4px;
        vertical-align: 0em;
        background-color: currentColor;
        opacity: 0.55;
        -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10' fill='none'><path d='M2.5 5h5M5 2.5L7.5 5 5 7.5' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'/></svg>");
                mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10' fill='none'><path d='M2.5 5h5M5 2.5L7.5 5 5 7.5' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'/></svg>");
        -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
        -webkit-mask-position: center; mask-position: center;
        -webkit-mask-size: contain; mask-size: contain;
        transition: transform 160ms ease, opacity 160ms ease;
      }
      .meta-link:hover::after {
        opacity: 0.85;
        transform: translateX(1px);
      }

      /* --- Page body --- */
      .page-body {
        max-width: 720px;
        margin: 0;
        padding: 132px 32px 200px 96px;
      }

      /* --- Universal cascade for direct children of .page-body --- */
      .page-body > * {
        opacity: 0;
        transform: translateY(3px);
        transition:
          opacity 360ms ease,
          transform 360ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .page-body.entered > * {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        .page-body > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        html, body { transition: none; }
      }

      /* --- External link ↗ arrow (SVG-based: shorter, thicker) --- */
      a[href^="http"]:not([href*="cretu.dev"])::after {
        content: '';
        display: inline-block;
        width: 0.62em;
        height: 0.62em;
        margin-left: 2px;
        vertical-align: 0em;
        background-color: currentColor;
        opacity: 0.5;
        -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10' fill='none'><path d='M3.2 7L7 3.2M7 3.2H3.9M7 3.2V6.3' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>");
                mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10' fill='none'><path d='M3.2 7L7 3.2M7 3.2H3.9M7 3.2V6.3' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>");
        -webkit-mask-repeat: no-repeat;
                mask-repeat: no-repeat;
        -webkit-mask-position: center;
                mask-position: center;
        -webkit-mask-size: contain;
                mask-size: contain;
        transition: opacity 160ms ease, transform 160ms ease;
      }
      a[href^="http"]:not([href*="cretu.dev"]):hover::after {
        opacity: 0.85;
        transform: translate(0.5px, -0.5px);
      }
      a[data-mention]::after,
      a[data-no-arrow]::after,
      .page-nav .links a::after,
      .page-nav .name::after {
        content: none !important;
      }

      @media (max-width: 720px) {
        .page-nav {
          top: 18px;
          left: 18px;
          right: 18px;
          font-size: 12px;
        }
        .page-body {
          padding: 108px 24px 160px 60px;
        }
      }

      @media (pointer: coarse) {
        /* Expand nav and toggle hit areas without changing visual size */
        .page-nav .links a,
        .page-nav .links button {
          padding: 8px 12px;
          margin: -8px -12px;
        }
        .theme-toggle {
          padding: 10px !important;
          margin: -4px !important;
        }
        .theme-toggle svg {
          width: 18px;
          height: 18px;
        }
        .page-nav .name {
          padding: 8px;
          margin: -8px;
        }
        /* Outliner targets — bullets & rows for touch */
        .bullet-cell { padding: 10px; margin: -10px; }
        .row { min-height: 36px; }
      }

      /* --- Smooth caret-blink (overrides per-page steps(1) variants) --- */
      @keyframes caret-blink {
        0%   { opacity: 1; }
        100% { opacity: 0; }
      }
      .caret-blink {
        animation: caret-blink 1.1s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate !important;
      }
      @media (prefers-reduced-motion: reduce) {
        .caret-blink { animation: none !important; opacity: 1 !important; }
      }

      /* --- Custom direction-aware crossfade for view transitions --- */
      ::view-transition-old(root) {
        animation: page-out 240ms cubic-bezier(0.4, 0, 0.2, 1) both;
      }
      ::view-transition-new(root) {
        animation: page-in 320ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
      @keyframes page-out {
        0%   { opacity: 1; transform: translateY(0) scale(1); }
        100% { opacity: 0; transform: translateY(-4px) scale(0.998); }
      }
      @keyframes page-in {
        0%   { opacity: 0; transform: translateY(6px) scale(0.998); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation: none; }
      }

      /* --- Command palette --- */
      .cmdk { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; }
      .cmdk[hidden] { display: none; }
      .cmdk-backdrop {
        position: absolute; inset: 0; background: rgba(0,0,0,0.18);
        backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
        opacity: 0; transition: opacity 160ms ease;
      }
      .cmdk:not([hidden]) .cmdk-backdrop { opacity: 1; }
      .cmdk-panel {
        position: relative; width: min(440px, calc(100vw - 32px));
        background: var(--notion-bg); color: var(--notion-ink);
        border: 1px solid var(--notion-rule); border-radius: 10px;
        box-shadow: var(--notion-shadow);
        padding: 8px;
        transform: translateY(8px); opacity: 0;
        transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 200ms ease;
      }
      .cmdk:not([hidden]) .cmdk-panel { transform: translateY(0); opacity: 1; }
      .cmdk-input {
        width: 100%; background: transparent; border: 0; outline: 0;
        padding: 10px 12px; font-family: inherit; font-size: 14px;
        color: var(--notion-ink); border-bottom: 1px solid var(--notion-rule);
      }
      .cmdk-input::placeholder { color: var(--notion-faint); }
      .cmdk-list { list-style: none; margin: 4px 0 0; padding: 0; max-height: 280px; overflow: auto; }
      .cmdk-list li {
        padding: 8px 12px; font-size: 14px; color: var(--notion-ink);
        cursor: pointer; border-radius: 6px;
        transition: background 120ms ease;
      }
      .cmdk-list li[aria-selected="true"],
      .cmdk-list li:hover {
        background: var(--notion-row-hover);
      }
      .cmdk-hint {
        display: flex; gap: 12px; align-items: center; padding: 8px 12px 4px;
        font-size: 11px; color: var(--notion-faint); border-top: 1px solid var(--notion-rule);
      }
      .cmdk-hint kbd {
        font-family: 'JetBrains Mono', monospace; font-size: 10px;
        background: var(--notion-tint); border-radius: 3px; padding: 1px 5px;
      }
    </style>
  </head>
  <body>
    <header class="page-nav" transition:persist>
      <a class="name" href="/">
        Cristian Crețu<br /><span class="yr">2026</span>
      </a>
      <nav class="links">
        <a href="/work">Work</a>
        <a href="/writing">Writing</a>
        <a href="https://x.com/cristicrtu" target="_blank" rel="noopener noreferrer" data-no-arrow>X</a>
        <a href="mailto:hi@cretu.dev" data-no-arrow>Email</a>
        <button class="theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
          <svg class="sun" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="3.2" fill="currentColor"/>
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="8" y1="1.6" x2="8" y2="3"/>
              <line x1="8" y1="13" x2="8" y2="14.4"/>
              <line x1="1.6" y1="8" x2="3" y2="8"/>
              <line x1="13" y1="8" x2="14.4" y2="8"/>
              <line x1="3.5" y1="3.5" x2="4.5" y2="4.5"/>
              <line x1="11.5" y1="11.5" x2="12.5" y2="12.5"/>
              <line x1="3.5" y1="12.5" x2="4.5" y2="11.5"/>
              <line x1="11.5" y1="4.5" x2="12.5" y2="3.5"/>
            </g>
          </svg>
          <svg class="moon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13 9.2A5.5 5.5 0 0 1 6.8 3a5.5 5.5 0 1 0 6.2 6.2Z" fill="currentColor"/>
          </svg>
        </button>
      </nav>
    </header>

    <main class="page-body" id="page-body" transition:animate="fade">
      <slot />
    </main>

    <div class="cmdk" role="dialog" aria-modal="true" aria-label="Command palette" hidden>
      <div class="cmdk-backdrop"></div>
      <div class="cmdk-panel">
        <input class="cmdk-input" type="text" placeholder="type to search…" aria-label="Search commands" autocomplete="off" />
        <ul class="cmdk-list" role="listbox">
          <li role="option" data-href="/" data-keys="home start">Home</li>
          <li role="option" data-href="/writing" data-keys="writing essays posts">Writing</li>
          <li role="option" data-href="/work" data-keys="work projects">Work</li>
          <li role="option" data-href="/resources" data-keys="resources links books talks">Resources</li>
          <li role="option" data-href="mailto:hi@cretu.dev" data-keys="email contact">Email</li>
        </ul>
        <div class="cmdk-hint"><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>↵</kbd> open <kbd>esc</kbd> close</div>
      </div>
    </div>

    <script is:inline>
      (function () {
        /* cascade-in for top-level children of .page-body
           Runs only on first page load (per session). Subsequent navigations
           render instantly to avoid repetitive motion. */
        const CASCADE_KEY = 'cretu_cascaded';
        function arm(body) {
          if (!body) return;
          const seen = sessionStorage.getItem(CASCADE_KEY) === '1';
          const kids = body.children;
          if (seen) {
            body.classList.add('entered');
            for (let i = 0; i < kids.length; i++) {
              kids[i].style.transitionDelay = '0ms';
            }
            return;
          }
          const total = 600;
          const base = 40;
          const step = Math.min(35, (total - base) / Math.max(kids.length - 1, 1));
          for (let i = 0; i < kids.length; i++) {
            kids[i].style.transitionDelay = (base + i * step) + 'ms';
          }
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              body.classList.add('entered');
              sessionStorage.setItem(CASCADE_KEY, '1');
            });
          });
        }
        arm(document.getElementById('page-body'));
        document.addEventListener('astro:after-swap', function () {
          const b = document.getElementById('page-body');
          if (b) b.classList.remove('entered');
          arm(b);
        });

        /* theme toggle */
        function setTheme(t) {
          document.documentElement.dataset.theme = t;
          try { localStorage.setItem('theme', t); } catch (_) {}
        }
        document.addEventListener('click', function (e) {
          const btn = e.target && e.target.closest && e.target.closest('[data-theme-toggle]');
          if (!btn) return;
          const cur = document.documentElement.dataset.theme || 'light';
          btn.classList.add('rotating');
          setTimeout(function () { btn.classList.remove('rotating'); }, 320);
          setTheme(cur === 'dark' ? 'light' : 'dark');
        });

        /* command palette */
        (function cmdK() {
          const root = document.querySelector('.cmdk');
          if (!root) return;
          const input = root.querySelector('.cmdk-input');
          const list = root.querySelector('.cmdk-list');
          const items = Array.from(list.querySelectorAll('li'));
          let idx = 0;
          function open() {
            root.hidden = false;
            requestAnimationFrame(() => input.focus());
            select(0);
          }
          function close() { root.hidden = true; input.value = ''; render(); }
          function select(i) {
            const visible = items.filter(it => !it.hidden);
            if (!visible.length) return;
            idx = (i + visible.length) % visible.length;
            items.forEach(it => it.setAttribute('aria-selected', it === visible[idx] ? 'true' : 'false'));
            visible[idx].scrollIntoView({ block: 'nearest' });
          }
          function render() {
            const q = input.value.trim().toLowerCase();
            items.forEach(it => {
              const keys = (it.dataset.keys + ' ' + it.textContent).toLowerCase();
              it.hidden = q && !q.split(/\s+/).every(t => keys.includes(t));
            });
            select(0);
          }
          document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              root.hidden ? open() : close();
              return;
            }
            if (e.key === '/' && !/input|textarea/i.test(document.activeElement.tagName)) {
              e.preventDefault();
              open();
              return;
            }
            if (root.hidden) return;
            if (e.key === 'Escape') { e.preventDefault(); close(); }
            else if (e.key === 'ArrowDown') { e.preventDefault(); select(idx + 1); }
            else if (e.key === 'ArrowUp')   { e.preventDefault(); select(idx - 1); }
            else if (e.key === 'Enter') {
              e.preventDefault();
              const visible = items.filter(it => !it.hidden);
              const chosen = visible[idx];
              if (chosen) {
                const href = chosen.dataset.href;
                close();
                window.location.href = href;
              }
            }
          });
          input && input.addEventListener('input', render);
          root.querySelector('.cmdk-backdrop').addEventListener('click', close);
          list.addEventListener('click', (e) => {
            const li = e.target.closest('li');
            if (!li) return;
            const href = li.dataset.href;
            close();
            window.location.href = href;
          });
        })();
      })();
    </script>
  </body>
</html>
