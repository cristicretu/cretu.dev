---
import NotionLayout from '@/layouts/NotionLayout.astro';
import Mention from '@/components/Mention.astro';
import { works } from '@/data/work';

const totalProjects = works.length;
const firstYear = Math.min(...works.map((work) => work.year));
const latestYear = Math.max(...works.map((work) => work.year));

const featuredProjects = [
  {
    key: 'agents',
    title: 'Anara Agents',
    context: 'Anara · 2025',
    summary:
      'Specialized agents that turn open-ended research into coordinated search, analysis, and writing workflows.',
    role: 'design engineering',
    result: 'shipped in Anara 2.0',
    link: 'https://anara.com/updates/two-dot-zero',
    image: '/static/images/work/agents.webp',
    width: 2046,
    height: 1152,
    alt: 'Anara composer with specialized research agent suggestions',
  },
  {
    key: 'family',
    title: 'Family Drawer',
    context: 'independent · 2025',
    summary:
      'A from-scratch SwiftUI recreation of Family’s gesture-driven drawer, focused on motion, depth, and interruption.',
    role: 'interaction design + SwiftUI',
    result: 'published as an open-source reference',
    link: 'https://github.com/cristicretu/family-drawer',
    image: '/static/images/work/family.webp',
    width: 1856,
    height: 1620,
    alt: 'SwiftUI recreation of the Family app drawer on an iPhone',
  },
  {
    key: 'hive',
    title: 'Hive',
    context: 'with Mihai Farcaș · 2025',
    summary:
      'A CLI that runs coding agents in parallel while isolating each task in its own Git worktree.',
    role: 'product + engineering',
    result: 'parallel work without file collisions',
    link: 'https://hive.cretu.dev/',
    image: '/static/images/work/cli.webp',
    width: 2088,
    height: 710,
    alt: 'Hive terminal interface showing isolated parallel agent tasks',
  },
] as const;

const yearMap = works.reduce((acc, w) => {
  (acc[w.year] = acc[w.year] || []).push(w);
  return acc;
}, {} as Record<number, typeof works>);

const years = Object.keys(yearMap)
  .map(Number)
  .sort((a, b) => b - a);

const fullYears = years.filter((y) => yearMap[y].length >= 2);
const earlierYears = years.filter((y) => yearMap[y].length < 2);
const earlierProjects = earlierYears.flatMap((y) => yearMap[y]);
const earlierIsCollapsible = earlierProjects.length >= 2;
const inlineEarlier = earlierProjects.length === 1 ? earlierProjects[0] : null;
const lastFullYearIndex = fullYears.length - 1;
---

<NotionLayout title="Work" description="stuff i built — solo, with collaborators, at companies." wide>
  <div class="work-page">
    <a class="page-back" href="/"><span class="back-arrow" aria-hidden="true">↩</span>Index</a>
    <div class="doc-title">work<span class="age">, {totalProjects} projects</span></div>

    <p class="doc-sub">
      selected product design, interface engineering, and tools. the complete archive follows.
    </p>

    <section class="featured-work" aria-labelledby="featured-work-title">
      <div class="section-heading">
        <h2 id="featured-work-title">featured</h2>
        <span>{featuredProjects.length} projects</span>
      </div>

      <div class="featured-grid">
        {featuredProjects.map((project, index) => (
          <article class:list={['featured-card', { 'featured-card--lead': index === 0 }]}>
            <a
              class="featured-media"
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              data-no-arrow
              aria-label={`View ${project.title}`}
            >
              <img
                class={`featured-image featured-image--${project.key}`}
                src={project.image}
                width={project.width}
                height={project.height}
                alt={project.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            </a>

            <div class="featured-copy">
              <p class="featured-context">{project.context}</p>
              <h3><a href={project.link} target="_blank" rel="noopener noreferrer">{project.title}</a></h3>
              <p class="featured-summary">{project.summary}</p>
              <dl class="featured-facts">
                <div>
                  <dt>role</dt>
                  <dd>{project.role}</dd>
                </div>
                <div>
                  <dt>result</dt>
                  <dd>{project.result}</dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="work-archive" aria-labelledby="work-archive-title">
      <div class="section-heading section-heading--archive">
        <h2 id="work-archive-title">archive</h2>
        <span>{firstYear}–{latestYear}</span>
      </div>

      {fullYears.map((year, idx) => {
        const items = yearMap[year];
        const openByDefault = idx < 2; /* most recent two years expanded */
        const isLastFull = idx === lastFullYearIndex;
        return (
          <div class={`node has-children${openByDefault ? ' open' : ''}`} data-node>
            <button class="row has-children" type="button" aria-expanded={openByDefault}>
              <span class="bullet-cell">
                <span class="bullet"></span>
                <span class="caret" aria-hidden>
                  <svg viewBox="0 0 8 8" fill="none">
                    <path d="M2 1l4 3-4 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
              <span class="label">{year}<span class="count">{items.length}</span></span>
            </button>
            <div class="children">
              {items.map((work) => (
                <div class="node" data-node>
                  <div class="row">
                    <span class="bullet-cell"><span class="bullet"></span></span>
                    <span class="label work-line">
                      {work.link ? (
                        <Mention href={work.link}>{work.title.toLowerCase()}</Mention>
                      ) : (
                        <span class="work-title">{work.title.toLowerCase()}</span>
                      )}
                      <span class="work-desc">{work.description.toLowerCase()}</span>
                      {work.company && <span class="meta">{work.company.toLowerCase()}</span>}
                    </span>
                  </div>
                </div>
              ))}
              {isLastFull && inlineEarlier && (
                <div class="node" data-node>
                  <div class="row">
                    <span class="bullet-cell"><span class="bullet"></span></span>
                    <span class="label work-line">
                      {inlineEarlier.link ? (
                        <Mention href={inlineEarlier.link}>{inlineEarlier.title.toLowerCase()}</Mention>
                      ) : (
                        <span class="work-title">{inlineEarlier.title.toLowerCase()}</span>
                      )}
                      <span class="work-desc">{inlineEarlier.description.toLowerCase()}</span>
                      {inlineEarlier.company && <span class="meta">{inlineEarlier.company.toLowerCase()}</span>}
                      <span class="meta">earlier · {inlineEarlier.year}</span>
                    </span>
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })}

      {earlierIsCollapsible && (
        <div class="node has-children" data-node>
          <button class="row has-children" type="button" aria-expanded="false">
            <span class="bullet-cell">
              <span class="bullet"></span>
              <span class="caret" aria-hidden>
                <svg viewBox="0 0 8 8" fill="none">
                  <path d="M2 1l4 3-4 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
            <span class="label">earlier<span class="count">{earlierProjects.length}</span></span>
          </button>
          <div class="children">
            {earlierProjects.map((work) => (
              <div class="node" data-node>
                <div class="row">
                  <span class="bullet-cell"><span class="bullet"></span></span>
                  <span class="label work-line">
                    {work.link ? (
                      <Mention href={work.link}>{work.title.toLowerCase()}</Mention>
                    ) : (
                      <span class="work-title">{work.title.toLowerCase()}</span>
                    )}
                    <span class="work-desc">{work.description.toLowerCase()}</span>
                    {work.company && <span class="meta">{work.company.toLowerCase()}</span>}
                    <span class="meta">{work.year}</span>
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <div class="write-row" aria-hidden>
      <span class="ghost-bullet"></span>
      <span><span class="caret-blink"></span></span>
    </div>
  </div>
</NotionLayout>

<style is:global>
  /* Outliner-specific styles, mirrored from the homepage. */
  .work-page {
    width: 100%;
  }

  .doc-title {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.3;
    padding: 0 0 16px;
    color: var(--notion-ink);
    cursor: text;
    font-feature-settings: 'kern' 1, 'cv11', 'ss01';
    font-kerning: normal;
  }
  .doc-title .age {
    color: var(--notion-faint);
    font-weight: 400;
    line-height: 1.4;
  }

  .doc-sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--notion-muted);
    margin: 0 0 32px;
    max-width: 600px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 14px;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--notion-ink);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .section-heading > span {
    color: var(--notion-faint);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .featured-work {
    margin-bottom: 52px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px 20px;
  }

  .featured-card {
    min-width: 0;
  }

  .featured-card--lead {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(240px, 0.75fr);
    grid-column: 1 / -1;
    gap: 24px;
    align-items: start;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--notion-rule);
  }

  .featured-card:not(.featured-card--lead),
  .featured-card:not(.featured-card--lead) .featured-copy {
    display: flex;
    flex-direction: column;
  }

  .featured-card:not(.featured-card--lead) .featured-copy {
    flex: 1;
  }

  .featured-card:not(.featured-card--lead) .featured-summary {
    margin-bottom: 15px;
  }

  .featured-card:not(.featured-card--lead) .featured-facts {
    margin-top: auto;
  }

  .featured-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--notion-rule);
    border-radius: 8px;
    background: var(--notion-surface);
    box-shadow: var(--notion-shadow);
    isolation: isolate;
  }

  .featured-media:focus-visible,
  .featured-copy h3 a:focus-visible {
    outline: 2px solid var(--notion-ink);
    outline-offset: 3px;
  }

  .featured-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-image--family {
    object-position: 50% 8%;
  }

  .featured-image--hive {
    object-fit: contain;
    background: #1b1c20;
  }

  .featured-copy {
    min-width: 0;
    padding-top: 13px;
  }

  .featured-card--lead .featured-copy {
    padding-top: 2px;
  }

  .featured-context {
    margin: 0 0 7px;
    color: var(--notion-faint);
    font-size: 12px;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .featured-copy h3 {
    margin: 0;
    color: var(--notion-ink);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .featured-card--lead .featured-copy h3 {
    font-size: 22px;
  }

  .featured-copy h3 a {
    border-radius: 3px;
  }

  .featured-summary {
    margin: 9px 0 0;
    color: var(--notion-muted);
    font-size: 14px;
    line-height: 1.58;
    text-wrap: pretty;
  }

  .featured-facts {
    display: grid;
    gap: 7px;
    margin: 15px 0 0;
    padding: 13px 0 0;
    border-top: 1px solid var(--notion-rule);
  }

  .featured-facts > div {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
  }

  .featured-facts dt,
  .featured-facts dd {
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
  }

  .featured-facts dt {
    color: var(--notion-faint);
  }

  .featured-facts dd {
    color: var(--notion-ink);
  }

  .work-archive {
    padding-top: 28px;
    border-top: 1px solid var(--notion-rule);
  }

  .section-heading--archive {
    margin-bottom: 12px;
  }

  .node {
    position: relative;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: flex-start;
    padding: 2px 8px 2px 0;
    border-radius: 4px;
    cursor: text;
    font-size: 15px;
    line-height: 1.7;
    transition: background var(--dur-quick, 140ms) ease;
  }

  .row.has-children {
    width: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background var(--dur-quick, 140ms) ease,
      transform var(--dur-quick, 140ms) var(--ease-out-soft, ease);
  }
  .row.has-children:active { transform: scale(0.997); }

  .bullet-cell:active .bullet {
    transform: scale(0.7);
    transition: transform 100ms var(--ease-out-soft, ease);
  }
  .row:focus-visible {
    outline: none;
    background: var(--notion-row-focus);
  }
  .row:focus-visible::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background: var(--notion-ink);
    border-radius: 1px;
  }

  .bullet-cell {
    position: relative;
    width: 18px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
  }
  .bullet {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--notion-ink);
    flex-shrink: 0;
    box-sizing: border-box;
    transition:
      opacity var(--dur-quick, 160ms) ease,
      transform 140ms var(--ease-out-soft, cubic-bezier(0.2, 0.7, 0.2, 1));
  }

  .node.has-children:not(.open) > .row > .bullet-cell > .bullet {
    background: transparent;
    border: 1.5px solid var(--notion-ink);
    width: 9px;
    height: 9px;
  }

  .caret {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    color: var(--notion-faint);
    transition: opacity var(--dur-quick, 160ms) ease;
    pointer-events: none;
  }
  .caret svg {
    width: 8px;
    height: 8px;
    display: block;
    transition: transform var(--dur-normal, 220ms) var(--ease-out-soft, cubic-bezier(0.2, 0.7, 0.2, 1));
  }
  .node.open > .row > .bullet-cell > .caret svg { transform: rotate(90deg); }

  .label {
    min-width: 0;
    color: var(--notion-ink);
  }
  .label .meta {
    color: var(--notion-faint);
    font-weight: 400;
    padding-left: 10px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    /* mono dropped per voice — sans throughout */
    white-space: nowrap;
  }
  .children {
    position: relative;
    margin-left: 26px;
    padding-left: 0;
    overflow: hidden;
    transition:
      max-height 260ms var(--ease-out-soft, cubic-bezier(0.2, 0.7, 0.2, 1)),
      opacity var(--dur-normal, 220ms) ease;
  }
  .node:not(.open) > .children {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }
  .node.open > .children {
    max-height: 4000px;
    opacity: 1;
  }

  /* Work-row description: muted, sits after title */
  .work-line {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .work-line .work-desc {
    color: var(--notion-muted);
    font-size: 14.5px;
    white-space: nowrap;
  }
  .work-line .work-title {
    color: var(--notion-ink);
  }
  .work-line .meta,
  .work-line code,
  .work-line .badge {
    white-space: nowrap;
    vertical-align: baseline;
    padding-left: 0;
  }

  .write-row {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: center;
    padding: 4px 8px 4px 0;
    border-radius: 4px;
    opacity: 0.65;
    transition: opacity var(--dur-normal, 200ms) ease, background var(--dur-quick, 140ms) ease;
  }
  .ghost-bullet {
    width: 18px;
    height: 24px;
    display: grid;
    place-items: center;
  }
  .ghost-bullet::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px dashed var(--notion-dim);
    box-sizing: border-box;
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-media:hover .featured-image {
      transform: scale(1.012);
    }
    .row:hover { background: var(--notion-row-hover); }
    .row:hover .bullet { transform: scale(1.4); }
    .node.has-children > .row:hover > .bullet-cell > .bullet { opacity: 0; }
    .node.has-children > .row:hover > .bullet-cell > .caret { opacity: 1; }
    .write-row:hover { background: var(--notion-row-hover); opacity: 1; }
  }

  @media (max-width: 760px) {
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .featured-card,
    .featured-card--lead {
      display: block;
      grid-column: auto;
      padding-bottom: 28px;
      border-bottom: 1px solid var(--notion-rule);
    }

    .featured-card:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .featured-card--lead .featured-copy,
    .featured-copy {
      padding-top: 13px;
    }

    .featured-card:not(.featured-card--lead) .featured-facts {
      margin-top: 15px;
    }

    .featured-card:not(.featured-card--lead) .featured-summary {
      margin-bottom: 0;
    }

    .featured-card--lead .featured-copy h3 {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-image {
      transition: none;
    }

    .featured-media:hover .featured-image {
      transform: none;
    }
  }
</style>

<script is:inline>
  (function init() {
    function wire() {
      /* fold / unfold for outliner parents */
      const parents = document.querySelectorAll('.node.has-children');
      parents.forEach(function (node) {
        if (node.dataset.wired) return;
        node.dataset.wired = '1';
        const row = node.querySelector(':scope > .row');
        if (!row) return;
        row.addEventListener('click', function (e) {
          if (e.target && e.target.closest && e.target.closest('a')) return;
          const isOpen = !node.classList.contains('open');
          node.classList.toggle('open', isOpen);
          row.setAttribute('aria-expanded', String(isOpen));
        });
      });
    }

    wire();
    document.addEventListener('astro:after-swap', wire);
  })();
</script>
