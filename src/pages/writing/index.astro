---
import NotionLayout from '@/layouts/NotionLayout.astro';
import { getCollection } from 'astro:content';
import { START, getDays } from '@/data/days';
import { specimenFor } from '@/scripts/variants/specimen';

const allPosts = await getCollection('writing');
const sorted = allPosts.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
const groups = sorted.reduce((acc, p) => {
  const year = String(new Date(p.data.publishedAt).getFullYear());
  (acc[year] ||= []).push(p);
  return acc;
}, {} as Record<string, typeof sorted>);
const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));

// Every essay is a flower in the meadow; here each one is pressed beside its title.
const days = await getDays();
const pressed = (publishedAt: string) => {
  const i = Math.round((Date.parse(publishedAt) - Date.parse(START)) / 86400000);
  if (i < 0 || i >= days.length) return null;
  const data = specimenFor(days, START, i);
  return { data, aspect: (1.24 * 100) / (data.h * 1.32 + 6) };
};
---

<NotionLayout title="Writing" description="thoughts on design, code, and life.">
  <a class="page-back" href="/"><span class="back-arrow" aria-hidden="true">↩</span>Meadow</a>
  <div class="doc-title">writing<span class="age">, {sorted.length} {sorted.length === 1 ? 'essay' : 'essays'}</span></div>
  <p class="index-sub">brain dumps. shaped by what I'm building, reading, or annoyed by. each one is a flower in the meadow.</p>

  {years.map((year) => (
    <section class="press-year">
      <h2 class="press-y" data-ink-item>{year}</h2>
      <ul class="press-list">
        {groups[year].map((post) => {
          const date = new Date(post.data.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }).toLowerCase();
          const p = pressed(post.data.publishedAt);
          return (
            <li data-ink-item>
              <a class="press" href={`/writing/${post.slug}`} data-press>
                <span class="press-sprig" aria-hidden="true" data-specimen={p ? JSON.stringify(p.data) : undefined} style={p ? `--aspect:${p.aspect.toFixed(4)}` : undefined}>{p && <canvas />}</span>
                <span class="press-t">{post.data.title.replace(/[.!?]+$/, '').toLowerCase()}</span>
                <time class="press-d" datetime={post.data.publishedAt}>{date}</time>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</NotionLayout>

<style is:global>
  .doc-title {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.3;
    padding: 0 0 16px;
    color: var(--notion-ink);
    font-feature-settings: 'kern' 1, 'cv11', 'ss01';
    font-kerning: normal;
  }
  .doc-title .age {
    color: var(--notion-faint);
    font-weight: 400;
  }
  .index-sub {
    color: var(--notion-muted);
    max-width: 540px;
    font-size: 15px;
    line-height: 1.65;
    margin: 0 0 40px;
  }

  /* A herbarium: years down the page, each essay a pressed bunch and its title. */
  .press-year {
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: 8px;
    margin: 0 0 28px;
  }
  .press-y {
    margin: 0;
    padding-top: 20px;
    font-size: 12px;
    font-weight: 400;
    color: var(--notion-faint);
    font-variant-numeric: tabular-nums;
  }
  .press-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .press {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: end;
    column-gap: 14px;
    max-width: 580px;
    padding: 4px 10px 6px 0;
    color: var(--notion-ink);
    text-decoration: none;
    border-radius: 10px;
  }
  .press-sprig {
    display: grid;
    justify-items: center;
    align-items: end;
    height: 52px;
  }
  .press-sprig canvas {
    display: block;
    height: 52px;
    width: calc(52px * var(--aspect, 0.8));
  }
  .press-t {
    padding-bottom: 6px;
    font-size: 15px;
    line-height: 1.45;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 calc(100% - 4px);
    background-repeat: no-repeat;
    transition: background-size 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .press-d {
    padding-bottom: 7px;
    font-size: 12px;
    color: var(--notion-faint);
    font-variant-numeric: tabular-nums;
  }
  @media (hover: hover) and (pointer: fine) {
    .press:hover .press-t { background-size: 100% 1px; }
  }
  .press:focus-visible {
    outline: none;
    background: var(--notion-row-focus);
  }
  @media (max-width: 639px) {
    .press-year { grid-template-columns: 1fr; }
    .press-y { padding: 0 0 4px; }
  }
</style>
