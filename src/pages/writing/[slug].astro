---
import NotionLayout from '@/layouts/NotionLayout.astro';
import { getCollection } from 'astro:content';
import '@/styles/prose.css';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const dateFmt = new Date(post.data.publishedAt)
  .toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  })
  .toLowerCase();

const raw = (post.body || '').replace(/[^\w\s]/g, '');
const words = raw.split(/\s+/).filter(Boolean).length;
const mins = Math.max(1, Math.round(words / 200));

const editUrl = `https://github.com/cristicretu/cretu.dev/edit/main/src/content/writing/${post.slug}.mdx`;
---

<NotionLayout
  title={post.data.title}
  description={post.data.summary}
  image={post.data.image}
>
  <article class="post">
    <header class="post-head">
      <p class="post-date">
        {dateFmt}
        <span class="post-meta">· {mins} min · {words.toLocaleString()} words</span>
      </p>
      <a class="post-breadcrumb" href="/writing">← writing</a>
      <h1 class="post-title" tabindex="0">{post.data.title.toLowerCase()}</h1>
    </header>

    {post.data.image && (
      <img class="post-cover" alt={post.data.title} src={post.data.image} />
    )}

    <div class="prose" data-prose>
      <Content />
    </div>

    <aside class="post-toc" aria-label="On this page" id="post-toc"></aside>

    <div class="post-write-row" aria-hidden="true">
      <span class="ghost-bullet"></span>
      <span class="post-caret-area">
        <span class="post-caret-blink"></span>
        <span class="post-slash-hint">Type "/" for commands</span>
      </span>
    </div>

    <footer class="post-footer">
      <a href={editUrl} rel="noopener noreferrer" target="_blank">
        edit on github
      </a>
    </footer>
  </article>
</NotionLayout>

<script is:inline>
  (function () {
    function wire() {
      /* Make headings focusable so the keyboard accent-bar can show */
      var proseHeadings = document.querySelectorAll('.prose h1, .prose h2, .prose h3');
      proseHeadings.forEach(function (h) {
        if (!h.hasAttribute('tabindex')) h.setAttribute('tabindex', '0');
      });

      /* Copy section URL on anchor click — Notion's link-to-block */
      var anchors = document.querySelectorAll('.prose .anchor');
      anchors.forEach(function (a) {
        if (a.dataset.wired) return;
        a.dataset.wired = '1';
        a.setAttribute('aria-label', 'Copy link to section');
        a.addEventListener('click', function (e) {
          e.preventDefault();
          var heading = a.closest('h1, h2, h3, h4, h5, h6');
          if (!heading || !heading.id) return;
          var url = window.location.origin + window.location.pathname + '#' + heading.id;
          try {
            history.replaceState(null, '', '#' + heading.id);
          } catch (_) {}
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () {
              a.classList.add('copied');
              setTimeout(function () { a.classList.remove('copied'); }, 1200);
            }).catch(function () {});
          }
        });
      });

      /* Build right-side TOC if there are >= 3 H2 headings */
      buildToc();
    }

    function buildToc() {
      var prose = document.querySelector('.prose');
      var toc = document.getElementById('post-toc');
      if (!prose || !toc) return;
      /* Clear any prior content (after-swap) */
      toc.innerHTML = '';
      toc.hidden = false;
      var heads = prose.querySelectorAll('h2, h3');
      var h2count = prose.querySelectorAll('h2').length;
      if (h2count < 3) { toc.hidden = true; return; }
      var ul = document.createElement('ul');
      heads.forEach(function (h, i) {
        if (!h.id) h.id = 'h-' + i;
        var li = document.createElement('li');
        li.className = 'post-toc-' + h.tagName.toLowerCase();
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        li.appendChild(a);
        ul.appendChild(li);
      });
      toc.appendChild(ul);
      /* highlight current */
      var links = toc.querySelectorAll('a');
      if (!('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          var id = e.target.id;
          var link = toc.querySelector('a[href="#' + id + '"]');
          if (!link) return;
          if (e.isIntersecting) {
            links.forEach(function (l) { l.classList.remove('current'); });
            link.classList.add('current');
          }
        });
      }, { rootMargin: '-40% 0px -55% 0px' });
      heads.forEach(function (h) { io.observe(h); });
    }

    wire();
    document.addEventListener('astro:after-swap', wire);
  })();
</script>
