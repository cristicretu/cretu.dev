---
import NotionLayout from '@/layouts/NotionLayout.astro';
import Mention from '@/components/Mention.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
  )
  .slice(0, 3);
---

<NotionLayout>
  <div class="doc-title">Cristian Crețu<span class="age">, 21</span></div>

  <div class="node" data-node>
    <div class="row">
      <span class="bullet-cell"><span class="bullet"></span></span>
      <span class="label">design engineer at <Mention href="https://anara.com">Anara</Mention></span>
    </div>
  </div>

  <div class="node has-children open" data-node>
    <div class="row has-children" tabindex="0">
      <span class="bullet-cell">
        <span class="bullet"></span>
        <span class="caret" aria-hidden>
          <svg viewBox="0 0 8 8" fill="none">
            <path d="M2 1l4 3-4 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </span>
      <span class="label">now<span class="meta" data-now-stamp aria-hidden="true"></span></span>
    </div>
    <div class="children">
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label">drawing more, shipping less</span></div>
      </div>
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label">obsessed with the half-second before you understand a screen</span></div>
      </div>
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label">redrawing my own site for the nth time</span></div>
      </div>
    </div>
  </div>

  <div class="node has-children" data-node>
    <div class="row has-children" tabindex="0">
      <span class="bullet-cell">
        <span class="bullet"></span>
        <span class="caret" aria-hidden>
          <svg viewBox="0 0 8 8" fill="none">
            <path d="M2 1l4 3-4 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </span>
      <span class="label">selected work<span class="count">3</span></span>
    </div>
    <div class="children">
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label"><Mention href="https://anara.com/changelog/two-dot-zero">Anara Agents</Mention></span></div>
      </div>
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label"><Mention href="https://github.com/cristicretu/family-drawer">Family Drawer</Mention></span></div>
      </div>
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label"><Mention href="https://hive.cretu.dev/">Hive</Mention></span></div>
      </div>
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label"><a class="meta-link" href="/work">all work</a></span></div>
      </div>
    </div>
  </div>

  <div class="node has-children open" data-node>
    <div class="row has-children" tabindex="0">
      <span class="bullet-cell">
        <span class="bullet"></span>
        <span class="caret" aria-hidden>
          <svg viewBox="0 0 8 8" fill="none">
            <path d="M2 1l4 3-4 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </span>
      <span class="label">writing<span class="count">{latestPosts.length}</span></span>
    </div>
    <div class="children">
      {latestPosts.map((post) => (
        <div class="node" data-node>
          <div class="row">
            <span class="bullet-cell"><span class="bullet"></span></span>
            <span class="label"><Mention href={`/writing/${post.slug}`}>{post.data.title.toLowerCase()}</Mention><span class="meta">{post.data.publishedAt.slice(0, 4)}</span></span>
          </div>
        </div>
      ))}
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label"><a class="meta-link" href="/writing">all essays</a></span></div>
      </div>
    </div>
  </div>

  <div class="node has-children open" data-node>
    <div class="row has-children" tabindex="0">
      <span class="bullet-cell">
        <span class="bullet"></span>
        <span class="caret" aria-hidden>
          <svg viewBox="0 0 8 8" fill="none">
            <path d="M2 1l4 3-4 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </span>
      <span class="label">elsewhere</span>
    </div>
    <div class="children">
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label"><Mention href="https://x.com/cristicrtu">x.com/cristicrtu</Mention></span></div>
      </div>
      <div class="node" data-node>
        <div class="row"><span class="bullet-cell"><span class="bullet"></span></span><span class="label"><Mention href="mailto:hi@cretu.dev">hi@cretu.dev</Mention></span></div>
      </div>
    </div>
  </div>

  <div class="write-row" aria-hidden>
    <span class="ghost-bullet"></span>
    <span><span class="caret-blink"></span></span>
  </div>
</NotionLayout>

<style is:global>
  /* Outliner-specific styles, scoped via top-level class names used only on / */
  .doc-title {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.3;
    padding: 0 0 14px;
    color: var(--notion-ink);
    cursor: text;
    font-feature-settings: 'kern' 1, 'cv11', 'ss01';
    font-kerning: normal;
  }
  .doc-title .age {
    color: var(--notion-faint);
    font-weight: 400;
    line-height: 1.4;
  }
  .doc-title::after {
    content: '';
    display: inline-block;
    margin-left: 8px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 240ms ease, transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  body.greeted .doc-title::after {
    content: '👋';
    opacity: 1;
    transform: translateX(0);
    animation: wave 1.2s ease-in-out;
  }
  @keyframes wave {
    0%, 100% { transform: rotate(0); }
    20%, 60% { transform: rotate(14deg); }
    40%, 80% { transform: rotate(-8deg); }
  }
  body.greeted .bullet::before {
    animation: pulse-bullet 800ms ease-out;
  }
  @keyframes pulse-bullet {
    0%   { transform: scale(1); }
    50%  { transform: scale(2.4); opacity: 0.4; }
    100% { transform: scale(1); }
  }
  .node > .row > .label {
    transition: color var(--dur-normal, 220ms) var(--ease-out-soft, ease), text-decoration-color var(--dur-normal, 220ms) var(--ease-out-soft, ease);
  }
  .node.done > .row > .label {
    text-decoration: line-through;
    text-decoration-color: var(--notion-faint);
    color: var(--notion-faint);
  }
  .node.done > .row > .bullet-cell > .bullet::before {
    background: var(--notion-faint);
    transform: scale(0.85);
    transition: background var(--dur-normal, 220ms) var(--ease-out-soft, ease), transform var(--dur-normal, 220ms) var(--ease-spring, ease);
  }

  .node {
    position: relative;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: flex-start;
    padding: 2px 8px 2px 0;
    border-radius: 4px;
    cursor: text;
    font-size: 15px;
    line-height: 1.7;
    transition: background var(--dur-quick, 140ms) ease;
  }
  .row:hover { background: var(--notion-row-hover); }

  .row.has-children { cursor: pointer; }
  .row:focus-visible {
    outline: none;
    background: var(--notion-row-focus);
  }
  .row:focus-visible::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background: var(--notion-ink);
    border-radius: 1px;
  }

  .bullet-cell {
    position: relative;
    width: 18px;
    height: 24px;
    cursor: pointer;
  }
  .bullet {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity var(--dur-quick, 140ms) ease;
  }
  .bullet::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--notion-ink);
    transition: transform var(--dur-quick, 180ms) var(--ease-out-soft, cubic-bezier(0.2, 0.7, 0.2, 1));
    box-sizing: border-box;
  }
  .row:hover .bullet::before { transform: scale(1.4); }

  .node.has-children:not(.open) > .row > .bullet-cell > .bullet::before {
    background: transparent;
    border: 1.5px solid var(--notion-ink);
    width: 9px;
    height: 9px;
  }

  .caret {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    color: var(--notion-faint);
    transition: opacity var(--dur-quick, 140ms) ease;
    pointer-events: none;
  }
  .caret svg {
    width: 8px;
    height: 8px;
    display: block;
    transition: transform var(--dur-normal, 220ms) var(--ease-out-soft, cubic-bezier(0.2, 0.7, 0.2, 1));
  }
  .node.has-children > .row:hover > .bullet-cell > .bullet { opacity: 0; }
  .node.has-children > .row:hover > .bullet-cell > .caret { opacity: 1; }
  .node.open > .row > .bullet-cell > .caret svg { transform: rotate(90deg); }

  .label {
    min-width: 0;
    color: var(--notion-ink);
  }
  .label .meta {
    color: var(--notion-faint);
    font-weight: 400;
    padding-left: 8px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  .label .count {
    display: inline-block;
    padding-left: 10px;
    font-size: 12px;
    color: var(--notion-faint);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: translateX(-2px);
    transition: opacity var(--dur-normal, 200ms) ease 60ms, transform var(--dur-normal, 200ms) ease 60ms;
  }
  .label .count::before {
    content: '· ';
    color: var(--notion-faint);
  }
  .node.has-children:not(.open) > .row > .label > .count {
    opacity: 1;
    transform: translateX(0);
  }

  .children {
    position: relative;
    margin-left: 26px;
    padding-left: 0;
    overflow: hidden;
    transition:
      max-height var(--dur-slow, 320ms) var(--ease-out-soft, cubic-bezier(0.2, 0.7, 0.2, 1)),
      opacity var(--dur-normal, 220ms) ease;
  }
  .children::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--notion-rule);
    transition: background 200ms ease;
  }
  .node.has-children:hover > .children::before {
    background: var(--notion-dim);
  }

  .node:not(.open) > .children {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }
  .node.open > .children {
    max-height: 1200px;
    opacity: 1;
  }

  .write-row {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: center;
    padding: 4px 8px 4px 0;
    border-radius: 4px;
    opacity: 0.7;
    transition: opacity var(--dur-normal, 200ms) ease, background var(--dur-quick, 140ms) ease;
  }
  .write-row:hover {
    background: var(--notion-row-hover);
    opacity: 1;
  }
  .ghost-bullet {
    width: 18px;
    height: 24px;
    display: grid;
    place-items: center;
  }
  .ghost-bullet::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px dashed var(--notion-dim);
    box-sizing: border-box;
  }
  .caret-blink {
    display: inline-block;
    width: 1.5px;
    height: 16px;
    background: var(--notion-ink);
    vertical-align: -3px;
    animation: caret-blink 1.1s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate;
  }
  @keyframes caret-blink {
    0%   { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret-blink { animation: none; opacity: 1; }
  }
</style>

<script is:inline>
  (function init() {
    function wire() {
      /* fold / unfold for outliner parents */
      const parents = document.querySelectorAll('.node.has-children');
      parents.forEach(function (node) {
        if (node.dataset.wired) return;
        node.dataset.wired = '1';
        const row = node.querySelector(':scope > .row');
        if (!row) return;
        row.addEventListener('click', function (e) {
          if (e.target && e.target.closest && e.target.closest('a')) return;
          node.classList.toggle('open');
        });
        row.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            node.classList.toggle('open');
          }
        });
      });

      /* now · {day · date} timestamp */
      const stamp = document.querySelector('[data-now-stamp]');
      if (stamp) {
        const now = new Date();
        const days = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
        const monthShort = now.toLocaleString('en-US', { month: 'short' }).toLowerCase();
        stamp.textContent = days[now.getDay()] + ' · ' + now.getDate() + ' ' + monthShort;
      }

      /* double-click bullet → toggle done state (visual only) */
      document.querySelectorAll('.row .bullet-cell .bullet').forEach((b) => {
        if (b.dataset.wiredDone) return;
        b.dataset.wiredDone = '1';
        const cell = b.parentElement;
        if (!cell) return;
        cell.addEventListener('dblclick', (e) => {
          const node = e.target.closest('.node');
          if (!node) return;
          if (node.classList.contains('has-children')) return;
          node.classList.toggle('done');
        });
      });
    }

    wire();
    document.addEventListener('astro:after-swap', wire);

    /* easter egg: typing "cristian" triggers a wave + bullet pulse */
    (function easterEgg() {
      const TARGET = 'cristian';
      let buf = '';
      document.addEventListener('keydown', (e) => {
        const active = document.activeElement;
        if (active && /input|textarea/i.test(active.tagName)) return;
        if (e.key.length !== 1) return;
        buf = (buf + e.key.toLowerCase()).slice(-TARGET.length);
        if (buf === TARGET) {
          document.body.classList.add('greeted');
          setTimeout(() => document.body.classList.remove('greeted'), 2400);
        }
      });
    })();
  })();
</script>
